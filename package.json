{
  "name": "oxnest",
  "version": "0.3.1",
  "description": "A lightweight NestJS starter template powered by Rust and the Oxidation Compiler.",
  "license": "MIT",
  "scripts": {
    "prepare": "node scripts/gen-swcrc.mts",
    "build": "nest build",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint",
    "lint:typecheck": "oxlint --type-check",
    "deps:audit": "pnpm audit",
    "deps:audit:high": "pnpm audit --audit-level high --ignore-registry-errors",
    "deps:audit:fix": "pnpm audit --fix update",
    "deps:dedupe": "pnpm dedupe",
    "deps:dedupe:check": "pnpm dedupe --check",
    "deps:outdated": "pnpm outdated",
    "deps:peers": "pnpm peers check",
    "deps:prune": "pnpm prune",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:cov": "vitest run --project unit --coverage",
    "test:debug": "vitest --project unit --inspect-brk --logHeapUsage --no-file-parallelism",
    "test:e2e": "vitest run --project e2e"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.20",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.2.2"
}
